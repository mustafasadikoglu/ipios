# --- Xcode projesi ---
# `IPiOS.xcodeproj` bilerek depoda tutulmaz: `project.yml` (XcodeGen) tek
# doğruluk kaynağıdır ve proje her derlemede ondan üretilir. Böylece
# birleştirme çakışmaları ve okunamayan pbxproj değişiklikleri oluşmaz.
*.xcodeproj
*.xcworkspace

# --- XcodeGen çıktıları ---
*.xcconfig

# --- Derleme çıktıları ---
build/
DerivedData/
*.o
*.dSYM/
*.app
*.ipa
*.xcarchive
*.swiftmodule
*.hmap
*.d

# --- Test sonuçları ---
*.xcresult

# --- Statik denetim raporu ---
# `scripts/static_check.py` her koşuda bu dosyayı üretir; CI'da artifact
# olarak yüklenir, depoda tutulmasına gerek yoktur.
static-check.txt

# --- Swift Package Manager ---
# `Package.resolved` bilerek dışlanmaz ama depoda da tutulmaz: proje XcodeGen
# ile üretildiği ve paket `project.yml` içinde `exactVersion` ile sabitlendiği
# için sürüm zaten tek bir yerde yazılıdır. İki yerde tutmak, birinin
# güncellenip diğerinin unutulması riskini getirirdi.
.swiftpm/
.build/
Package.resolved

# --- CI paket önbelleği ---
# `actions/cache` tarafından doldurulur (VLCKit ikilisi ~920 MB); depoda
# tutulmaz, yalnızca iş akışı içinde kullanılır.
package-cache/

# --- Bağımlılık yöneticileri (projede üçüncü taraf bağımlılık yok) ---
Pods/
Carthage/

# --- macOS ---
.DS_Store
._*
.Spotlight-V100
.Trashes

# --- Editör ---
*.swp
*.swo
*~
.idea/
.vscode/

# --- Python (doğrulama betikleri) ---
__pycache__/
*.pyc

# --- Geçici / kişisel dosyalar ---
# Kimlik bilgisi, sağlayıcı adresi veya token içerebilecek dosyalar buraya
# konmamalı; yanlışlıkla eklenirse diye yine de listeleniyor.
*.local.md
*.local.json
secrets.plist
secrets.xcconfig
